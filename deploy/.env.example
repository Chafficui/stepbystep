# Diese Datei nach .env kopieren und die Werte anpassen:
#   cp deploy/.env.example deploy/.env

# Domain, unter der die App erreichbar ist (DNS muss auf den Server zeigen)
DOMAIN=event.example.com

# Postgres
POSTGRES_USER=stepbystep
POSTGRES_PASSWORD=please-change-me
POSTGRES_DB=stepbystep

# Orga-Passwort für das Dashboard (stark wählen!)
ORGA_PASSWORD=please-change-me-too

# Zufälliger Sitzungsschlüssel, z.B. `openssl rand -hex 32`
ORGA_SESSION_SECRET=please-generate-a-random-64-hex-string
